// ═══════════════════════════════════════════════════════════════════════════════
// Neo3D — Jenkins CI/CD Pipeline
// Declarative Pipeline (Groovy DSL)
//
// Stages:
//   1. Checkout         — Pull latest code from Git
//   2. Validate Env     — Verify .env and config
//   3. Build Images     — docker compose build
//   4. Smoke Test       — Start backend locally, hit /health/
//   5. Validate API     — Run backend's validation script
//   6. Push to Registry — Push Docker images to Docker Hub
//   7. Deploy to EC2    — SSH into EC2, pull images, and restart containers
//   8. Report           — Print result summary
// ═══════════════════════════════════════════════════════════════════════════════

pipeline {
    agent any

    options {
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    environment {
        COMPOSE_PROJECT_NAME = 'neo3d_ci'
        IMAGE_TAG = "${env.GIT_COMMIT?.take(8) ?: 'latest'}"
        BACKEND_HEALTH_URL = 'http://localhost:8001/api/v1/health/'
        
        // Docker Hub Credentials (must be configured in Jenkins Credentials as 'dockerhub-creds')
        DOCKER_USER = credentials('dockerhub-creds-user')
        DOCKER_PASS = credentials('dockerhub-creds-pass')

        // EC2 Deployment Credentials
        // EC2_SSH_KEY: Jenkins SSH Username with private key credential ('ec2-ssh-key')
        // EC2_HOST: e.g., 'ubuntu@3.111.222.111' configured as secret text or injected via env
        EC2_HOST = credentials('ec2-host')
    }

    stages {
        stage('Checkout') {
            steps {
                echo '=== STAGE 1: Pulling latest code ==='
                checkout scm
                sh 'git log --oneline -3'
                echo "Building commit: ${IMAGE_TAG}"
            }
        }

        stage('Validate Environment') {
            steps {
                echo '=== STAGE 2: Validating environment ==='
                script {
                    if (!fileExists('.env')) error('.env file missing.')
                    if (!fileExists('docker-compose.yml')) error('docker-compose.yml missing.')
                    echo '\033[32m[PASS] All environment checks passed\033[0m'
                }
            }
        }

        stage('Build Images') {
            steps {
                echo '=== STAGE 3: Building Docker images ==='
                script {
                    def buildArgs = env.BRANCH_NAME == 'main' ? '--no-cache' : ''
                    
                    // Build tagging with both 'latest' and the git SHA
                    sh "docker build ${buildArgs} -t ${DOCKER_USER}/neo3d-backend:latest -t ${DOCKER_USER}/neo3d-backend:${IMAGE_TAG} -f docker/backend/Dockerfile ."
                    sh "docker build ${buildArgs} -t ${DOCKER_USER}/neo3d-frontend:latest -t ${DOCKER_USER}/neo3d-frontend:${IMAGE_TAG} -f docker/frontend/Dockerfile ."
                    sh "docker build ${buildArgs} -t ${DOCKER_USER}/neo3d-worker:latest -t ${DOCKER_USER}/neo3d-worker:${IMAGE_TAG} -f docker/worker/Dockerfile ."
                }
            }
        }

        stage('Smoke Test') {
            steps {
                echo '=== STAGE 4: Smoke test (backend health check) ==='
                script {
                    try {
                        sh 'docker compose up -d backend'
                        sleep(20)
                        sh "curl --fail --silent --show-error --max-time 10 ${BACKEND_HEALTH_URL}"
                        echo '\033[32m[PASS] Backend health check passed\033[0m'
                    } finally {
                        sh 'docker compose down --remove-orphans'
                    }
                }
            }
        }

        stage('Validate API') {
            steps {
                echo '=== STAGE 5: API contract validation ==='
                script {
                    try {
                        sh 'docker compose up -d backend'
                        sleep(20)
                        sh 'docker compose exec -T backend python run_api_validation.py'
                        echo '\033[32m[PASS] API validation passed\033[0m'
                    } catch (Exception e) {
                        echo "\033[33m[WARN] API validation skipped or failed: ${e.message}\033[0m"
                    } finally {
                        sh 'docker compose down --remove-orphans'
                    }
                }
            }
        }

        stage('Push to Registry') {
            // Only push to registry if we are on the main branch
            when { branch 'main' }
            steps {
                echo '=== STAGE 6: Pushing images to Docker Hub ==='
                script {
                    sh "echo ${DOCKER_PASS} | docker login -u ${DOCKER_USER} --password-stdin"
                    
                    sh "docker push ${DOCKER_USER}/neo3d-backend:latest"
                    sh "docker push ${DOCKER_USER}/neo3d-backend:${IMAGE_TAG}"
                    
                    sh "docker push ${DOCKER_USER}/neo3d-frontend:latest"
                    sh "docker push ${DOCKER_USER}/neo3d-frontend:${IMAGE_TAG}"
                    
                    sh "docker push ${DOCKER_USER}/neo3d-worker:latest"
                    sh "docker push ${DOCKER_USER}/neo3d-worker:${IMAGE_TAG}"
                }
            }
        }

        stage('Deploy to EC2') {
            // Only deploy from main branch
            when { branch 'main' }
            steps {
                echo '=== STAGE 7: Deploying to AWS EC2 ==='
                withCredentials([sshUserPrivateKey(credentialsId: 'ec2-ssh-key', keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
                    script {
                        // Transfer docker-compose.prod.yml to the EC2 instance
                        sh "scp -i ${SSH_KEY} -o StrictHostKeyChecking=no docker-compose.prod.yml ${EC2_HOST}:~/docker-compose.yml"
                        
                        // Execute pull and up on the EC2 instance
                        def deployCmd = """
                            export DOCKER_USER=${DOCKER_USER}
                            docker compose pull
                            docker compose up -d
                            docker system prune -f
                        """
                        sh "ssh -i ${SSH_KEY} -o StrictHostKeyChecking=no ${EC2_HOST} '${deployCmd}'"
                        echo '\033[32m[PASS] Deployed successfully to EC2\033[0m'
                    }
                }
            }
        }

        stage('Report') {
            steps {
                echo '=== STAGE 8: Build report ==='
                script {
                    echo """
╔══════════════════════════════════════════════════════╗
║            Neo3D CI/CD Pipeline — COMPLETE           ║
╠══════════════════════════════════════════════════════╣
║  Branch:   ${env.BRANCH_NAME ?: 'unknown'}
║  Commit:   ${IMAGE_TAG}
║  Status:   SUCCESS
╚══════════════════════════════════════════════════════╝
"""
                }
            }
        }
    }

    post {
        always {
            sh 'docker compose down --remove-orphans --volumes 2>/dev/null || true'
            sh 'docker logout || true'
            archiveArtifacts artifacts: 'logs/*.log', allowEmptyArchive: true
        }
        success {
            echo '\033[32m✓ Neo3D CI Pipeline PASSED\033[0m'
        }
        failure {
            echo '\033[31m✗ Neo3D CI Pipeline FAILED — Check logs above\033[0m'
        }
    }
}
