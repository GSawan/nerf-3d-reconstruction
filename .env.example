# ─────────────────────────────────────────────────────────────────────────────
# Neo3D Production Environment Variables
# Copy this file to .env and fill in all values before deploying.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# For local dev, aiosqlite is used automatically if DATABASE_URL is empty.
# For production (PostgreSQL on EC2):
DATABASE_URL=postgresql+asyncpg://neo3d:CHANGE_ME@db:5432/neo3d
POSTGRES_USER=neo3d
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=neo3d

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_USE_32_CHARS_MIN
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AWS S3 (Optional — leave empty to use local disk storage) ─────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=

# ── Frontend ──────────────────────────────────────────────────────────────────
# In production, this is your EC2 Elastic IP or domain:
NEXT_PUBLIC_API_URL=http://YOUR_ELASTIC_IP

# ── COLMAP ────────────────────────────────────────────────────────────────────
COLMAP_PATH=/usr/bin/colmap

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
MAX_UPLOAD_MB=2048
MIN_IMAGES=5
