# ═══════════════════════════════════════════════════════════════
# Neo3D — Environment Variable Template
# ═══════════════════════════════════════════════════════════════
# HOW TO USE:
#   1. Copy this file: cp .env.example .env
#   2. Fill in values in .env
#   3. NEVER commit .env to Git (it's in .gitignore)
#
# This file IS committed — it's a safe template showing what
# variables are needed, without containing real values.
# ═══════════════════════════════════════════════════════════════

# ─── Backend ────────────────────────────────────────────────────
# Port the FastAPI backend listens on (inside container: always 8001)
BACKEND_PORT=8001

# Path to COLMAP executable
# LOCAL (Windows):  C:\Users\YourName\Downloads\COLMAP\COLMAP.bat
# DOCKER (Linux):   /usr/bin/colmap  (installed via apt in worker container)
COLMAP_PATH=/usr/bin/colmap

# Logging
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# LOG_FORMAT: human (colored, readable) | json (machine-readable for prod)
LOG_FORMAT=json

# Upload limits
MAX_UPLOAD_MB=2048
MIN_IMAGES=5
MAX_IMAGES=300

# ─── Frontend ───────────────────────────────────────────────────
# External port the Next.js UI is exposed on
FRONTEND_PORT=3000

# Internal URL the frontend (Next.js server) uses to reach the backend
# In Docker Compose: use the service name — http://backend:8001
# Locally: leave empty (uses proxy rewrite → 127.0.0.1:8001)
BACKEND_INTERNAL_URL=http://backend:8001

# Public API URL for client-side fetches (leave empty to use Next.js proxy)
NEXT_PUBLIC_API_URL=

# ─── Jenkins ────────────────────────────────────────────────────
JENKINS_PORT=8080
JENKINS_AGENT_PORT=50000

# Git repository URL for Jenkins to pull from
GIT_REPO_URL=https://github.com/youruser/neo3d.git
GIT_BRANCH=main

# ─── Volumes ────────────────────────────────────────────────────
# These are named Docker volumes — you don't need to change these
# unless you want to use host bind mounts instead
DATASETS_VOLUME=neo3d_datasets
OUTPUTS_VOLUME=neo3d_outputs
LOGS_VOLUME=neo3d_logs
